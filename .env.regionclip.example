# Optional official Microsoft RegionCLIP integration
# Clone https://github.com/microsoft/RegionCLIP and download matching files
# from its official model zoo before enabling this backend.
REGIONCLIP_ENABLED=1
REGIONCLIP_ROOT=/opt/RegionCLIP
REGIONCLIP_CONFIG=/opt/RegionCLIP/configs/LVISv1-InstanceSegmentation/CLIP_fast_rcnn_R_50_C4_custom_img.yaml
REGIONCLIP_WEIGHTS=/opt/RegionCLIP/pretrained_ckpt/regionclip/regionclip_pretrained-cc_rn50x4.pth
REGIONCLIP_TEXT_EMB=/opt/RegionCLIP/pretrained_ckpt/concept_emb/lvis_1203_cls_emb_rn50x4.pth
REGIONCLIP_LABELS=/opt/RegionCLIP/lvis_1203_labels.txt
REGIONCLIP_TEXT_EMB_DIM=640
REGIONCLIP_POOLER_RESOLUTION=18
REGIONCLIP_DEVICE=cuda

# A YOLO proposal below this confidence is transferred to RegionCLIP.
# This is a tunable validation parameter, not a trained/calibrated value.
REGIONCLIP_TRANSFER_THRESHOLD=0.50

# RegionCLIP softmax score below this value is rejected.
# Default action keeps the YOLO label; use "drop" to remove the region.
REGIONCLIP_REJECT_THRESHOLD=0.30
REGIONCLIP_REJECT_ACTION=keep_yolo
REGIONCLIP_TEMPERATURE=0.01
REGIONCLIP_ALL_REGIONS=0
